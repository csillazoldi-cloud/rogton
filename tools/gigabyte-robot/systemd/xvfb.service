# D-F38 (2026-09-13): virtuális kijelző a Synology Drive kliens Qt-részének — a Gigabyte-on nincs asztali bejelentkezés.
# Telepítés: cp tools/gigabyte-robot/systemd/*.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now xvfb synology-drive
[Unit]
Description=Xvfb :99 — virtuális kijelző a fejetlen Synology Drive klienshez

[Service]
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x800x24 -nolisten tcp
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
