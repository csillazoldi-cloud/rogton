[
 {
  "id": "K1",
  "nev": "Pontosan egy jelzés kompozíciónként",
  "csoport": "kompozicio",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "signal"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "count_exact",
   "countElements": {
    "idPrefix": "signal"
   },
   "exact": 1,
   "signalKinds": [
    "rule",
    "dot",
    "highlighted_element",
    "arc",
    "opening_quote"
   ],
   "artSignalDropsRule": true,
   "emblemIsNotSignal": true
  },
  "szigorusag": "tiltas",
  "uzenet": "A kompozíción pontosan egy jelzés lehet (vonalka / pont / kiemelt elem / ív / nyitó idézőjel); az embléma nem jelzés."
 },
 {
  "id": "K8",
  "nev": "Egy kiemelőszín-szerep",
  "csoport": "kompozicio",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "*"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "count_max",
   "color": "@color.accent",
   "excludeRole": "secondaryLanguageText",
   "maxRoles": 1,
   "roles": [
    "rule",
    "dot",
    "focus_bar",
    "arc"
   ]
  },
  "szigorusag": "figyelmeztetes",
  "uzenet": "A kiemelőszín a másodlagos nyelv színén kívül csak egy szerepben jelenhet meg (vonalka, pont, fókusz-sáv vagy ív)."
 },
 {
  "id": "K9",
  "nev": "Accent alap csak indulásra vagy egy eseményre",
  "csoport": "kompozicio",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "carousel45"
  ],
  "mezoTipus": [
   "*"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "enum_only",
   "when": {
    "ground": "accent"
   },
   "allowedContentTypes": [
    "launch",
    "event"
   ],
   "forbiddenContentTypes": [
    "practical",
    "data",
    "comparison",
    "thanks",
    "howto",
    "service"
   ]
  },
  "szigorusag": "tiltas",
  "uzenet": "Kiemelőszínű háttér csak 'launch' vagy 'event' tartalomtípusra; határidő, összehasonlítás, köszönet, gyakorlati, jegy/bérlet, adat sosem."
 },
 {
  "id": "K14",
  "nev": "Gyakorlati poszt: egy tipográfiai hős",
  "csoport": "kompozicio",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "*"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "enum_only",
   "when": {
    "contentType": "practical"
   },
   "heroKinds": [
    "numeral_list_3",
    "date",
    "place",
    "tick_boxes",
    "hours",
    "before_after",
    "calendar"
   ],
   "heroCount": 1,
   "forbid": [
    "icon",
    "card",
    "ui_chrome"
   ],
   "forbidGround": [
    "accent"
   ]
  },
  "szigorusag": "tiltas",
  "uzenet": "Gyakorlati poszton pontosan egy hős elem lehet (számlista 3 / dátum / hely / pipa-doboz / óraszám / előtte→utána / naptár), ikonok, kártyák, UI-elemek nélkül."
 },
 {
  "id": "K18",
  "nev": "Lépés-dia szerep nélkül",
  "csoport": "kompozicio",
  "formatum": [
   "carousel45"
  ],
  "mezoTipus": [
   "label"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "required_field",
   "when": {
    "genre": "howto"
   },
   "require": "role"
  },
  "szigorusag": "tiltas",
  "uzenet": "How-to dián kötelező a szerep-címke."
 },
 {
  "id": "K22",
  "nev": "Adatkártya: legfeljebb két szám",
  "csoport": "kompozicio",
  "formatum": [
   "reel916"
  ],
  "mezoTipus": [
   "number",
   "dataLabel"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "count_max",
   "frame": "data_card",
   "maxNumbers": 2,
   "highlightedIsSignal": true,
   "labelMaxLines": 2
  },
  "szigorusag": "tiltas",
  "uzenet": "Reel-adatkártyán legfeljebb 2 szám lehet; a kiemelt szám a jelzés; címkék ≤ 2 sor/nyelv."
 },
 {
  "id": "N1",
  "nev": "Nyelvsorrend, azonos méret, azonos tények",
  "csoport": "nyelvek",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "*"
  ],
  "hatokor": "elem",
  "feltetel": {
   "check": "order",
   "order": "@lang.order",
   "sizeEqual": true,
   "factsIdentical": {
    "kezi": true,
    "szigorusag": "figyelmeztetes"
   }
  },
  "szigorusag": "tiltas",
  "uzenet": "Az elsődleges nyelv előbb, a másodlagos utána (@lang.order), azonos méreten; a tények azonossága emberi ellenőrzés."
 },
 {
  "id": "N3",
  "nev": "16:9: egy nyelv fájlonként",
  "csoport": "nyelvek",
  "formatum": [
   "wide169"
  ],
  "mezoTipus": [
   "*"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "count_exact",
   "languagesPerFile": 1,
   "sameLayoutAcrossLanguages": true,
   "metadataSuffix": "{@meta.separator}{langCode}"
  },
  "szigorusag": "tiltas",
  "uzenet": "A széles formátumban fájlonként egy nyelv lehet, azonos elrendezéssel, a metaadat a nyelvkóddal zárul."
 },
 {
  "id": "N7",
  "nev": "Ünnep hagyományonként, dátummal",
  "csoport": "nyelvek",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "table",
   "dataLabel"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "required_field",
   "when": {
    "layout": "calendar"
   },
   "require": [
    "tradition",
    "tradition.date"
   ],
   "printFirst": "tradition",
   "coincidingHolidaysWithDate": true
  },
  "szigorusag": "tiltas",
  "uzenet": "Naptár-poszton kötelező a 'tradition' mező (mindkét nyelven, dátummal, elsőként), és az egybeeső ünnepek dátummal listázva."
 },
 {
  "id": "A3",
  "nev": "comparison kötelező",
  "csoport": "szam-adat",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "chart",
   "number"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "required_field",
   "require": "comparison",
   "enum": {
    "change": {
     "glyph": "→",
     "form": "before_after"
    },
    "versus": {
     "divider": "hairline",
     "glyph": "vs",
     "noArrow": true
    },
    "rank": {
     "form": "ranked_list"
    }
   },
   "forbid": {
    "placeVsPlaceAs": "change"
   }
  },
  "szigorusag": "tiltas",
  "uzenet": "Hiányzik a 'comparison' mező (change = nyíl előtte→utána; versus = hajszálvonal, nyíl nélkül; rank = rangsorolt lista). Hely vs hely sosem időbeli változás."
 },
 {
  "id": "A4",
  "nev": "Hat réteg sorrendje",
  "csoport": "szam-adat",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "*"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "order",
   "when": {
    "contentType": "data"
   },
   "order": [
    "insight",
    "key_number",
    "supporting_data",
    "explanation",
    "source",
    "metadata"
   ],
   "exception": {
    "archetype": "conclusion",
    "order": [
     "numeric_contrast",
     "meaning_line",
     "conclusion",
     "source",
     "metadata"
    ]
   }
  },
  "szigorusag": "tiltas",
  "uzenet": "Adatposzt rétegei ebben a sorrendben: felismerés → kulcsszám → támogató adat → magyarázat → forrás → metaadat (kivétel: következtetés-kártya)."
 },
 {
  "id": "A15",
  "nev": "Számpár kötelező jele",
  "csoport": "szam-adat",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "number"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "required_field",
   "when": {
    "numberPairs": 1
   },
   "requireGlyph": [
    "vs",
    "→"
   ],
   "maxPairs": 1
  },
  "szigorusag": "tiltas",
  "uzenet": "Két egymás mellé állított szám között 'vs' vagy '→' jel kell (a comparison mezőből)."
 },
 {
  "id": "B1",
  "nev": "Formátumkészlet",
  "csoport": "biztonsagi-savok",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "*"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "enum_only",
   "allowed": {
    "feed45": [
     1080,
     1350
    ],
    "square11": [
     1080,
     1080
    ],
    "story916": [
     1080,
     1920
    ],
    "reel916": [
     1080,
     1920
    ],
    "wide169": [
     1920,
     1080
    ],
    "carousel45": [
     1080,
     1350
    ]
   },
   "scaleByAspect": true
  },
  "szigorusag": "tiltas",
  "uzenet": "Ismeretlen formátum; csak feed 4:5 (1080×1350), négyzet 1:1 (1080×1080), függőleges 9:16 (1080×1920), széles 16:9 (1920×1080) engedett, arányosan skálázva."
 },
 {
  "id": "H1",
  "nev": "Minden ábra forrással vagy illusztratív jelöléssel",
  "csoport": "forras-hitelesseg",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "number",
   "chart"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "required_field",
   "requireOneOf": [
    "source.short",
    "illustrativeLine == @lang.illustrativeLine"
   ],
   "illustrativeLineInsideFrame": true,
   "layoutUnchangedWhenSourceArrives": true
  },
  "szigorusag": "tiltas",
  "uzenet": "A számnak nincs forrása és nincs 'illusztratív adat' sora (@lang.illustrativeLine) a képen."
 },
 {
  "id": "H3",
  "nev": "Forráskártya csak idézhető dokumentummal",
  "csoport": "forras-hitelesseg",
  "formatum": [
   "reel916"
  ],
  "mezoTipus": [
   "source"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "required_field",
   "frame": "source_card",
   "require": "ref",
   "alternative": "key_thought_card",
   "institutionMaxLines": 2,
   "citationMaxLinesPerLanguage": 2
  },
  "szigorusag": "tiltas",
  "uzenet": "Forráskártyához kötelező a 'ref' (idézhető dokumentum); nélküle kulcsgondolat-kártyát használjon."
 },
 {
  "id": "H4",
  "nev": "Nincs kitalált idézet",
  "csoport": "forras-hitelesseg",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "quote"
  ],
  "hatokor": "elem",
  "feltetel": {
   "check": "required_field",
   "when": {
    "quote.attributed": true
   },
   "require": "consentRecord",
   "alternative": "key_thought_card",
   "quoteMaxLinesPerLanguage": 1
  },
  "szigorusag": "tiltas",
  "uzenet": "Attribútált idézethez írásos hozzájárulás-rekord kell; nélküle kulcsgondolat-kártya."
 },
 {
  "id": "H7",
  "nev": "Más intézmény döntése: attribúciós sor; vád soha",
  "csoport": "forras-hitelesseg",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "body",
   "lead"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "required_field",
   "when": {
    "decidedBy": "notEmpty"
   },
   "require": "attributionLine",
   "role": "tajekoztatas",
   "noAccusation": {
    "kezi": true
   }
  },
  "szigorusag": "figyelmeztetes",
  "uzenet": "Ha a 'decidedBy' mező ki van töltve, kötelező az attribúciós sor (@lang.attributionLine[institution], tájékoztatás szerep); a vádló megfogalmazás emberi ellenőrzés."
 }
]