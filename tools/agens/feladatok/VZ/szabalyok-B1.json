   },
   "forbidOnBusyArea": true
  },
  "szigorusag": "figyelmeztetes",
  "uzenet": "Fotón a metaadat @color.metaOnPhoto színű legyen; tompított szín csak ≥ @color.scrimMinForMutedMeta scrim fölött; zajos fotórészre nem kerülhet."
 },
 {
  "id": "K2",
