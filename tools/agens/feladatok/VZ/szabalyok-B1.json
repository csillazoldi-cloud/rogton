[
 {
  "id": "T4",
  "nev": "Technikai réteg: nagybetű, betűköz, arány",
  "csoport": "tipografia",
  "formatum": [
   "feed45",
   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "metadata",
   "source",
   "label",
   "kicker"
  ],
  "hatokor": "kompozicio",
  "feltetel": {
   "check": "ratio_max",
   "requireCase": "upper",
   "requireTracking": "@tech.tracking",
   "maxShareOfVisibleText": "@tech.maxShare",
   "maxLinesPerSlide": "@tech.maxLinesPerSlide"
  },
  "szigorusag": "figyelmeztetes",
  "uzenet": "A technikai réteg nagybetűs, @tech.tracking betűközzel, és legfeljebb a látható szöveg ~10 %-a; carousel-dián legfeljebb 3 rövid sor."
 },
 {
  "id": "M13",
  "nev": "Metaadat fotón: legkontrasztosabb szín, sosem zajos részen",
  "csoport": "meret",
