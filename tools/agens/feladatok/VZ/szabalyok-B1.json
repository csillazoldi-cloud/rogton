   "square11",
   "story916",
   "reel916",
   "wide169",
   "carousel45"
  ],
  "mezoTipus": [
   "metadata"
  ],
  "hatokor": "elem",
  "feltetel": {
   "check": "color_on_ground",
   "when": {
    "ground": "photo"
   },
   "requireColor": "@color.metaOnPhoto",
