# Rögtön — the host's .env (copy to $GMA_GYOKER/.env, mode 600, owner gyorsadmin). Placeholder values only.
# Every variable the app, the image maker and the compose file read is listed, with its class:
#   NEW   = a fresh value made for this install (never copied from any earlier system)
#   COPY  = the safe default shown here
#   REMOVED variables are listed at the bottom as comments: the code still reads some of them, and EMPTY/ABSENT means "off".

# --- paths (NEW) -----------------------------------------------------------------------------------------------------------
# the data root: adatok/{postgres,fajlok,album}, mentes/, uzem-aktiv/, naplo/, allapot/
GMA_GYOKER=/home/gyorsadmin/gma

# --- database (NEW: two random passwords, e.g. `openssl rand -base64 32 | tr -d '/+='`) -----------------------------------
KM_TULAJ_JELSZO=CHANGE_ME_owner_password
KM_APP_JELSZO=CHANGE_ME_app_password

# --- AI (NEW key; provider COPY) -------------------------------------------------------------------------------------------
AI_SZOLGALTATO=openai
HF_AI_SZOLGALTATO=openai
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODELL=gpt-5-mini
# OPENAI_URL is left unset: the default is the public OpenAI API
# monthly cap per organisation (USD) and the system-wide cap — set both explicitly
AI_HAVI_KERET_USD=5
AI_RENDSZER_KERET_USD=50

# --- people and addresses (NEW) --------------------------------------------------------------------------------------------
# the first system admin's login e-mail (an address on the product's own domain)
RENDSZERGAZDA_EMAIL=admin@example.hu
# the public address of the app (links in in-app texts)
NYILVANOS_CIM=https://admin.example.hu

# --- runtime (COPY) --------------------------------------------------------------------------------------------------------
HF_FUTTATO=1
# 1: nginx takes the visitor address from CF-Connecting-IP and overwrites X-Forwarded-For (uzem/nginx.conf); MEASURE on
# /api/belso/cim after go-live (the „ahogy_latjuk” value must be your own public address, not 172.x)
MEGBIZHATO_PROXY_DB=1

# --- G7: Cloudflare Tunnel (NEW) -------------------------------------------------------------------------------------------
# the token from Zero Trust → Networks → Tunnels → <tunnel> → install command (the long string after --token). Secret.
CF_TUNNEL_TOKEN=CHANGE_ME_tunnel_token
# turns the `tunnel` service on (leave it commented until the token is in place, or the tunnel container restarts in a loop)
# COMPOSE_PROFILES=tunnel

# --- set inside the compose file, not here (listed for completeness) ---------------------------------------------------------
# DATABASE_URL   built from KM_APP_JELSZO
# NODE_ENV=production, PORT=3000, HOSTNAME=0.0.0.0   (Dockerfile)
# FAJL_MAPPA=/adatok/fajlok, ALBUM_MAPPA=/adatok/album
# KEPGYAR_URL=http://kepgyar:8601
# G6 egress (WARP): no variables — free consumer WARP registers itself on first start (state in $GMA_GYOKER/adatok/warp)
# image maker: KEPGYAR_GYOKER, CHROMIUM, PORT=8601   (its Dockerfile defaults)

# --- REMOVED: not used by this install — do not set ------------------------------------------------------------------------
# ANTHROPIC_API_KEY, AI_MODELL                       (provider not used)
# AI_HID_CIM, CLAUDE_MODELL, CODEX_MODELL            (subscription bridge not part of this install)
# OLLAMA_URL, OLLAMA_MODELL, OLLAMA_KEEP_ALIVE, OLLAMA_MAX_VAR_MS   (no local model)
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM, SMTP_BIZTONSAG   (no outbound mail: empty = no mail, no error)
# ERTESITES_WEBHOOK_URL                              (no outbound webhook)
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, TELEGRAM_TESZTELO_NEV, TELEGRAM_FEJLESZTO_NEV   (feedback notices removed; digest stays in the DB)
# HUB_FEEDBACK_URL, HUB_WRITE_KEY, HUB_SLUG          (no external project board)
# KM_REF_IRAS, KM_REF_PROFIL                         (second demo host removed)
# PROBA_*, KAPU_JELOLO                               (tests only)
